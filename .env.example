# API keys
YOUTUBE_API_KEY=
FLICKR_API_KEY=
IO_KEY=
HF_TOKEN=
NASA_EOL_API_KEY=

# Storage roots: all append the mission slug first. Bulk media stays on D:.
# DATA_DIR defaults to the sibling ../ArtemisInRealTime_assets processing/web tree.
# DATA_DIR=F:/_repos/ArtemisInRealTime_assets
BULK_ASSETS_DIR=D:/ArtemisInRealTime_assets
# PDS defaults to BULK_ASSETS_DIR; override only for a separate archive drive.
# PDS_ASSETS_DIR=D:/ArtemisInRealTime_assets
# YT_VIDEO_DIR=D:/ArtemisInRealTime_yt_videos

# Audio processing
WHISPER_COMPUTE_TYPE="float16"
TORCHAUDIO_USE_BACKEND_DISPATCHER=1
